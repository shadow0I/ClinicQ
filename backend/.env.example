# Required PostgreSQL connection values
DB_USER=clinicq_app
DB_PASSWORD=replace-with-a-local-secret
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=clinicq_db
DB_SSLMODE=prefer

# Browser/API configuration
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false

# Safe local simulation. This mode never places a real call.
IVR_PROVIDER=mock

# Live Exotel configuration (set IVR_PROVIDER=exotel only after setup)
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_ACCOUNT_SID=
EXOTEL_CALLER_ID=
EXOTEL_IVR_URL=
EXOTEL_API_HOST=api.in.exotel.com
PUBLIC_API_BASE_URL=
IVR_WEBHOOK_SECRET=
